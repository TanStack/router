{
  "name": "@benchmarks/ssr-before-load-solid",
  "projectType": "application",
  "implicitDependencies": ["@tanstack/solid-start"],
  "namedInputs": {
    "sharedBenchmarkFiles": [
      "{workspaceRoot}/benchmarks/cpu-simulation.ts",
      "{workspaceRoot}/benchmarks/ssr/bench-utils.ts",
      "{workspaceRoot}/benchmarks/ssr/package.json",
      "{workspaceRoot}/benchmarks/ssr/scenarios/before-load/shared-bench.ts",
      "{workspaceRoot}/benchmarks/ssr/scenarios/before-load/shared.ts",
      "{workspaceRoot}/benchmarks/ssr/tsconfig.json",
      "{workspaceRoot}/benchmarks/ssr/vitest.solid.config.ts",
      "{workspaceRoot}/benchmarks/tsconfig.json",
      "{workspaceRoot}/benchmarks/vitest-projects.ts"
    ]
  },
  "targets": {
    "build:ssr": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "command": "NODE_ENV=production vite build --config {projectRoot}/vite.config.ts"
      }
    },
    "test:types:ssr": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json --noEmit"
      }
    }
  }
}
