{
  "name": "@benchmarks/client-nav-history-vue",
  "projectType": "application",
  "implicitDependencies": ["@tanstack/router-plugin", "@tanstack/vue-router"],
  "namedInputs": {
    "sharedBenchmarkFiles": [
      "{workspaceRoot}/benchmarks/client-nav/jsdom.ts",
      "{workspaceRoot}/benchmarks/client-nav/package.json",
      "{workspaceRoot}/benchmarks/client-nav/scenarios/harness.ts",
      "{workspaceRoot}/benchmarks/client-nav/scenarios/history/shared.ts",
      "{workspaceRoot}/benchmarks/client-nav/setup-helpers.ts",
      "{workspaceRoot}/benchmarks/client-nav/tsconfig.json",
      "{workspaceRoot}/benchmarks/client-nav/vitest.setup.ts",
      "{workspaceRoot}/benchmarks/client-nav/vitest.vue.config.ts",
      "{workspaceRoot}/benchmarks/cpu-simulation.ts",
      "{workspaceRoot}/benchmarks/tsconfig.json",
      "{workspaceRoot}/benchmarks/vitest-projects.ts"
    ]
  },
  "targets": {
    "build:client": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "command": "NODE_ENV=production vite build --config {projectRoot}/vite.config.ts"
      }
    },
    "test:types:client": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json --noEmit"
      }
    },
    "test:flame": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build:client"],
      "options": {
        "command": "NODE_ENV=production flame run --md-format=detailed --delay=none --node-options=\"--stack-size=65500\" ./scenarios/history/vue/speed.flame.ts",
        "cwd": "benchmarks/client-nav"
      }
    }
  }
}
