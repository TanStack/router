{
  "name": "@benchmarks/memory-server-serialization-payload-react",
  "projectType": "application",
  "implicitDependencies": ["@tanstack/react-start"],
  "namedInputs": {
    "sharedBenchmarkFiles": [
      "{workspaceRoot}/benchmarks/memory/flame-control.ts",
      "{workspaceRoot}/benchmarks/memory/runtime.ts",
      "{workspaceRoot}/benchmarks/memory/server/bench-utils.ts",
      "{workspaceRoot}/benchmarks/memory/server/benchmark.ts",
      "{workspaceRoot}/benchmarks/memory/server/flame-runner.ts",
      "{workspaceRoot}/benchmarks/memory/server/package.json",
      "{workspaceRoot}/benchmarks/memory/server/scenarios/serialization-payload/serialization-payload.ts",
      "{workspaceRoot}/benchmarks/memory/server/scenarios/serialization-payload/shared.ts",
      "{workspaceRoot}/benchmarks/memory/server/tsconfig.json",
      "{workspaceRoot}/benchmarks/memory/server/vitest.react.config.ts",
      "{workspaceRoot}/benchmarks/memory/server/vitest.setup.ts",
      "{workspaceRoot}/benchmarks/memory/tsconfig.json",
      "{workspaceRoot}/benchmarks/memory/turn.ts",
      "{workspaceRoot}/benchmarks/vitest-projects.ts"
    ]
  },
  "targets": {
    "build:ssr": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "command": "NODE_ENV=production vite build --config {projectRoot}/vite.config.ts"
      }
    },
    "build:ssr:flame": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "command": "NODE_ENV=production vite build --config {projectRoot}/vite.config.ts --sourcemap true"
      }
    },
    "test:flame": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "cache": false,
      "dependsOn": ["build:ssr:flame"],
      "options": {
        "command": "NODE_ENV=production node benchmarks/memory/run-flame.mjs {projectRoot}/memory.flame.ts {projectRoot}/dist",
        "cwd": "."
      }
    },
    "test:types:ssr": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json --noEmit"
      }
    }
  }
}
