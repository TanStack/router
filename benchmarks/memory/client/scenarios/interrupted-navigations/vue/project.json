{
  "name": "@benchmarks/memory-client-interrupted-navigations-vue",
  "projectType": "application",
  "implicitDependencies": ["@tanstack/vue-router"],
  "namedInputs": {
    "sharedBenchmarkFiles": [
      "{workspaceRoot}/benchmarks/memory/client/bench-utils.ts",
      "{workspaceRoot}/benchmarks/memory/client/benchmark.ts",
      "{workspaceRoot}/benchmarks/memory/client/flame-runner.ts",
      "{workspaceRoot}/benchmarks/memory/client/jsdom.ts",
      "{workspaceRoot}/benchmarks/memory/client/lifecycle.ts",
      "{workspaceRoot}/benchmarks/memory/client/package.json",
      "{workspaceRoot}/benchmarks/memory/client/scenarios/interrupted-navigations/shared.ts",
      "{workspaceRoot}/benchmarks/memory/client/scenarios/interrupted-navigations/slow-loaders.ts",
      "{workspaceRoot}/benchmarks/memory/client/tsconfig.json",
      "{workspaceRoot}/benchmarks/memory/client/vitest.setup.ts",
      "{workspaceRoot}/benchmarks/memory/client/vitest.vue.config.ts",
      "{workspaceRoot}/benchmarks/memory/flame-control.ts",
      "{workspaceRoot}/benchmarks/memory/runtime.ts",
      "{workspaceRoot}/benchmarks/memory/tsconfig.json",
      "{workspaceRoot}/benchmarks/memory/turn.ts",
      "{workspaceRoot}/benchmarks/vitest-projects.ts"
    ]
  },
  "targets": {
    "build:client": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "command": "NODE_ENV=production vite build --config {projectRoot}/vite.config.ts"
      }
    },
    "build:client:flame": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "command": "NODE_ENV=production vite build --config {projectRoot}/vite.config.ts --sourcemap true"
      }
    },
    "test:flame": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "cache": false,
      "dependsOn": ["build:client:flame"],
      "options": {
        "command": "NODE_ENV=production node benchmarks/memory/run-flame.mjs {projectRoot}/memory.flame.ts {projectRoot}/dist",
        "cwd": "."
      }
    },
    "test:types:client": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json --noEmit"
      }
    }
  }
}
