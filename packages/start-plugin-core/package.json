{
  "name": "@tanstack/start-plugin-core",
  "version": "1.171.55",
  "description": "Modern and scalable routing for React applications",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/router.git",
    "directory": "packages/start-plugin-core"
  },
  "homepage": "https://tanstack.com/start",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "solid",
    "react",
    "location",
    "router",
    "routing",
    "async",
    "async router",
    "typescript"
  ],
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./coverage",
    "clean:snapshots": "rimraf **/*snapshot* --glob",
    "test": "pnpm test:eslint && pnpm test:types && pnpm test:build && pnpm test:unit && pnpm test:integration && pnpm test:noncompiler",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration --project integration-alone --project integration-pages",
    "test:integration:smoke": "vitest --project integration integration/importProtection/build.test.ts integration/start-compose-project-path.test.ts integration/start-build-unparsed-module.test.ts -t \"build.*a denied re-export barrel the client uses fails the build|project-path|unparsed|of an app whose path\"",
    "test:eslint": "eslint ./src ./tests",
    "test:types": "pnpm run \"/^test:types:ts[0-9]{2}$/\"",
    "test:types:ts56": "node ../../node_modules/typescript56/lib/tsc.js",
    "test:types:ts57": "node ../../node_modules/typescript57/lib/tsc.js",
    "test:types:ts58": "node ../../node_modules/typescript58/lib/tsc.js",
    "test:types:ts59": "node ../../node_modules/typescript59/lib/tsc.js",
    "test:types:ts60": "tsc6",
    "test:types:ts70": "tsc",
    "test:build": "publint --strict && attw --ignore-rules no-resolution --pack .",
    "build": "vite build",
    "test:noncompiler": "vitest --project noncompiler"
  },
  "nx": {
    "targets": {
      "test:unit": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "@tanstack/react-start",
              "@tanstack/solid-start",
              "@tanstack/vue-start"
            ],
            "target": "build"
          }
        ],
        "parallelism": false
      },
      "test:integration": {
        "dependsOn": [
          "^build",
          "build",
          {
            "projects": [
              "@tanstack/react-start",
              "@tanstack/solid-start",
              "@tanstack/vue-start"
            ],
            "target": "build"
          }
        ],
        "parallelism": false
      },
      "test:integration:smoke": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "@tanstack/react-start"
            ],
            "target": "build"
          }
        ],
        "parallelism": false
      }
    }
  },
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/esm/utils.d.ts",
        "default": "./dist/esm/utils.js"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/esm/vite/index.d.ts",
        "default": "./dist/esm/vite/index.js"
      }
    },
    "./rsbuild": {
      "import": {
        "types": "./dist/esm/rsbuild/index.d.ts",
        "default": "./dist/esm/rsbuild/index.js"
      }
    },
    "./rsbuild/types": {
      "import": {
        "types": "./dist/esm/rsbuild/types.d.ts",
        "default": "./dist/esm/rsbuild/types.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tanstack/router-core": "workspace:*",
    "@tanstack/router-generator": "workspace:*",
    "@tanstack/router-plugin": "workspace:*",
    "@tanstack/router-utils": "workspace:*",
    "@tanstack/start-server-core": "workspace:*",
    "exsolve": "^1.1.3",
    "lightningcss": "^1.33.0",
    "pathe": "catalog:",
    "picomatch": "^4.0.7",
    "seroval": "^1.6.7",
    "srvx": "^1.0.0",
    "tinyglobby": "catalog:",
    "ufo": "^1.6.4",
    "vitefu": "^1.1.3",
    "xmlbuilder2": "^4.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-babel": "^1.1.2",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rsbuild/plugin-solid": "^1.2.2",
    "@types/node": ">=20",
    "@types/picomatch": "^4.0.2",
    "vite": "*",
    "vite-plugin-solid": "catalog:",
    "@tanstack/compiler-test-utils": "workspace:*",
    "@tanstack/react-router": "workspace:*",
    "@tanstack/vite-config": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
