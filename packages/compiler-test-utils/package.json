{
  "name": "@tanstack/compiler-test-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Test infrastructure shared by the compiler test suites: an ES module linker for compiled modules, a real-build harness, dev-server harnesses (Vite, Rsbuild), a real browser page and a validator of generated modules",
  "type": "module",
  "exports": {
    "./browser": "./src/browser.ts",
    "./budget-reporter": "./src/budget-reporter.ts",
    "./build-harness": "./src/build-harness.ts",
    "./dev-server": "./src/dev-server.ts",
    "./module-linker": "./src/module-linker.ts",
    "./rsbuild-dev-server": "./src/rsbuild-dev-server.ts",
    "./run-node": "./src/run-node.ts",
    "./validate-module": "./src/validate-module.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:types": "tsc",
    "test:eslint": "eslint ./src ./tests"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "dependencies": {
    "@playwright/test": "catalog:",
    "@rsbuild/core": "catalog:",
    "esbuild": "^0.28.2",
    "globals": "^16.2.0",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webpack": "^5.104.1"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
