{
  "name": "@tanstack/compiler-test-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Test infrastructure shared by the compiler test suites: a public in-process plugin host (Vite, Rsbuild) driving the plugins a user configures, a real-build harness, dev-server harnesses (Vite, Rsbuild), a real browser page, one merged diagnostic channel, and a validator of generated modules",
  "type": "module",
  "exports": {
    "./added-code": "./src/added-code.ts",
    "./app-directory": "./src/app-directory.ts",
    "./browser": "./src/browser.ts",
    "./budget-reporter": "./src/budget-reporter.ts",
    "./build-harness": "./src/build-harness.ts",
    "./determinism": "./src/determinism.ts",
    "./dev-server": "./src/dev-server.ts",
    "./diagnostic-channel": "./src/diagnostic-channel.ts",
    "./diagnostics": "./src/diagnostics.ts",
    "./global-trap": "./src/global-trap.ts",
    "./hmr-sync": "./src/hmr-sync.ts",
    "./importers": "./src/importers.ts",
    "./known-globals": "./src/known-globals.ts",
    "./lazy-probe": "./src/lazy-probe.ts",
    "./module-linker": "./src/module-linker.ts",
    "./outcome": "./src/outcome.ts",
    "./plugin-host": "./src/plugin-host.ts",
    "./render": "./src/render.ts",
    "./rsbuild-dev-server": "./src/rsbuild-dev-server.ts",
    "./rsbuild-plugin-host": "./src/rsbuild-plugin-host.ts",
    "./run-directory": "./src/run-directory.ts",
    "./run-node": "./src/run-node.ts",
    "./source-attribution": "./src/source-attribution.ts",
    "./source-maps": "./src/source-maps.ts",
    "./strict-runner": "./src/strict-runner.ts",
    "./test-scope": "./src/test-scope.ts",
    "./test-scope-setup": "./src/test-scope-setup.ts",
    "./validate-module": "./src/validate-module.ts",
    "./workspace-packages": "./src/workspace-packages.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:types": "tsc",
    "test:eslint": "eslint ./src ./tests",
    "test:import-gate": "node ./src/import-gate.ts",
    "test:import-gate:strict": "node ./src/import-gate.ts --strict"
  },
  "nx": {
    "targets": {
      "test:integration": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "@tanstack/history"
            ],
            "target": "build"
          }
        ]
      }
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "catalog:",
    "@rsbuild/core": "catalog:",
    "esbuild": "^0.28.2",
    "globals": "^16.2.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webpack": "^5.104.1"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
