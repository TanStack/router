{
  "name": "@tanstack/start-openapi",
  "version": "0.0.0",
  "description": "Generate an OpenAPI 3.1 document from TanStack Start server routes",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/router.git",
    "directory": "packages/start-openapi"
  },
  "homepage": "https://tanstack.com/start",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "tanstack",
    "start",
    "openapi",
    "swagger",
    "server routes",
    "typescript"
  ],
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./coverage",
    "test:eslint": "eslint ./src",
    "test:types": "tsc",
    "test:unit": "vitest",
    "test:build": "publint --strict && attw --ignore-rules no-resolution --pack .",
    "build": "vite build"
  },
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "*",
    "zod": "^4.4.3",
    "@types/node": ">=20",
    "@tanstack/vite-config": "catalog:",
    "vitest": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:"
  }
}
