{
  "name": "tanstack-start-example-learn",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite checkpoints/01-setup --port 3140",
    "build": "vite build checkpoints/01-setup && tsc -p checkpoints/01-setup",
    "start": "node checkpoints/01-setup/.output/server/index.mjs",
    "test:e2e": "playwright test",
    "db:generate:03": "prisma generate --config checkpoints/03-data/prisma.config.ts",
    "db:migrate:03": "prisma migrate deploy --config checkpoints/03-data/prisma.config.ts",
    "db:seed:03": "prisma db execute --file checkpoints/03-data/prisma/seed.sql --config checkpoints/03-data/prisma.config.ts",
    "db:generate:04": "prisma generate --config checkpoints/04-forms/prisma.config.ts",
    "db:migrate:04": "prisma migrate deploy --config checkpoints/04-forms/prisma.config.ts",
    "db:seed:04": "prisma db execute --file checkpoints/04-forms/prisma/seed.sql --config checkpoints/04-forms/prisma.config.ts",
    "db:generate:05": "prisma generate --config checkpoints/05-authentication/prisma.config.ts",
    "db:migrate:05": "prisma migrate deploy --config checkpoints/05-authentication/prisma.config.ts",
    "db:seed:05": "prisma db execute --file checkpoints/05-authentication/prisma/seed.sql --config checkpoints/05-authentication/prisma.config.ts",
    "db:generate:06": "prisma generate --config checkpoints/06-seo/prisma.config.ts",
    "db:migrate:06": "prisma migrate deploy --config checkpoints/06-seo/prisma.config.ts",
    "db:seed:06": "prisma db execute --file checkpoints/06-seo/prisma/seed.sql --config checkpoints/06-seo/prisma.config.ts",
    "db:generate:07": "prisma generate --config checkpoints/07-deployment/prisma.config.ts",
    "db:migrate:07": "prisma migrate deploy --config checkpoints/07-deployment/prisma.config.ts",
    "db:seed:07": "prisma db execute --file checkpoints/07-deployment/prisma/seed.sql --config checkpoints/07-deployment/prisma.config.ts",
    "build:07": "vite build checkpoints/07-deployment && tsc -p checkpoints/07-deployment",
    "start:07": "node checkpoints/07-deployment/.output/server/index.mjs",
    "db:generate:08": "prisma generate --config checkpoints/08-tests/prisma.config.ts",
    "db:migrate:08": "prisma migrate deploy --config checkpoints/08-tests/prisma.config.ts",
    "db:seed:08": "prisma db execute --file checkpoints/08-tests/prisma/seed.sql --config checkpoints/08-tests/prisma.config.ts",
    "build:08": "vite build checkpoints/08-tests && tsc -p checkpoints/08-tests",
    "start:08": "node checkpoints/08-tests/.output/server/index.mjs",
    "social:image": "node scripts/social-image.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "workspace:^",
    "@tanstack/react-start": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@prisma/adapter-pg": "7.0.0",
    "@prisma/client": "7.0.0",
    "zod": "^4.4.3",
    "better-auth": "1.6.19",
    "@better-auth/prisma-adapter": "1.6.19"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.260311-beta",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.14",
    "@playwright/test": "^1.61.0",
    "prisma": "7.0.0",
    "dotenv": "^17.2.3",
    "sharp": "0.35.4"
  }
}
