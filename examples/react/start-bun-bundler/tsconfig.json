{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun", "react", "react-dom"],
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts"]
}
