{
  "name": "@route-modules/products",
  "private": true,
  "type": "module",
  "tanstack": {
    "router": {
      "module": true
    }
  },
  "exports": {
    "./route-types": {
      "types": "./.tanstack/types/src/routeContract.gen.d.ts"
    },
    "./route-module": {
      "types": "./.tanstack/types/src/routeModule.gen.d.ts",
      "default": "./src/routeModule.gen.ts"
    },
    "./api": {
      "types": "./.tanstack/types/src/api.d.ts",
      "default": "./src/api.ts"
    },
    "./package.json": "./package.json",
    "./scope": {
      "types": "./.tanstack/types/src/routeScope.gen.d.ts",
      "default": "./src/routeScope.gen.ts"
    }
  },
  "scripts": {
    "generate": "tsr generate",
    "emit-types": "node -e \"require('node:fs').rmSync('.tanstack/types',{recursive:true,force:true})\" && tsc -p tsconfig.route-types.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "workspace:^",
    "react": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/router-cli": "workspace:^",
    "@tanstack/router-core": "workspace:^",
    "@types/react": "^19.0.8"
  },
  "nx": {
    "targets": {
      "generate": {
        "dependsOn": [
          "^build",
          "^emit-types"
        ]
      },
      "emit-types": {
        "dependsOn": [
          "generate"
        ]
      }
    }
  }
}
