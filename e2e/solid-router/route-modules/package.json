{
  "name": "tanstack-router-e2e-solid-route-modules",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/prepare.mjs",
    "build": "node scripts/prepare.mjs && vite build && tsc --noEmit && tsc -p packages/settings/tsconfig.json --noEmit",
