{
  "name": "@route-modules/solid-settings",
  "private": true,
  "type": "module",
  "tanstack": {
    "router": {
      "module": true
    }
  },
  "exports": {
    "./route-types": {
      "types": "./.tanstack/types/src/routeContract.gen.d.ts"
    },
    "./route-module": {
      "types": "./.tanstack/types/src/routeModule.gen.d.ts",
      "default": "./src/routeModule.gen.ts"
    },
    "./scope": {
      "types": "./.tanstack/types/src/routeScope.gen.d.ts",
      "default": "./src/routeScope.gen.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "tsr generate",
    "emit-types": "tsc -p tsconfig.route-types.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/solid-router": "workspace:^",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@tanstack/router-core": "workspace:^",
    "@tanstack/router-cli": "workspace:^"
  }
}
