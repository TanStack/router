{
  "name": "tanstack-solid-start-e2e-basic-auth",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:e2e": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "pnpx srvx --prod -s ../client dist/server/server.js",
    "prisma-generate": "prisma generate",
    "test:e2e": "mkdir -p .tmp; rm -f .tmp/dev.db .tmp/dev.db-journal .tmp/dev.db-wal .tmp/dev.db-shm; export DATABASE_URL=file:./.tmp/dev.db; pnpm run prisma-generate && pnpm exec prisma migrate deploy && playwright test --project=chromium"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "~7.9.1",
    "@prisma/client": "~7.9.1",
    "@tanstack/solid-router": "workspace:^",
    "@tanstack/solid-router-devtools": "workspace:^",
    "@tanstack/solid-start": "workspace:^",
    "iron-session": "^9.1.0",
    "redaxios": "catalog:",
    "solid-js": "^1.9.19",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-e2e-utils": "workspace:^",
    "@types/node": "^22.10.2",
    "dotenv": "^17.4.2",
    "prisma": "~7.9.1",
    "srvx": "^1.0.8",
    "tailwindcss": "^4.3.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16"
  },
  "nx": {
    "targets": {
      "test:e2e": {
        "outputs": [
          "...",
          "{projectRoot}/.tmp",
          "{projectRoot}/src/prisma-generated"
        ]
      }
    }
  }
}
